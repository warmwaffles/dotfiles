#!/bin/bash

echo "==> Removing merged branches"
git branch --merged | grep -v "\*" | cut -c 3- | grep -v -E "(master)|(main)" | xargs -n 1 git branch -d

echo "==> Pruning remote branches"
git remote | xargs -n 1 git remote prune

echo "==> Remove squashed branches"
git for-each-ref --format '%(refname:short)' refs/heads |
  grep -v '^main$' |
  while read -r branch; do
    merge_base=$(git merge-base main "$branch")
    squash=$(git commit-tree "$branch^{tree}" -p "$merge_base" -m "_" 2>/dev/null)
    if git cherry main "$squash" | grep -q "^-"; then
      git branch -D "$branch"
    fi
  done

echo "==> Removing any invalid tags"
git fetch --prune origin +refs/tags/*:refs/tags/*

echo "==> Expiring ref log"
git reflog expire --expire-unreachable=now --all

echo "==> Garbage collecting"
git gc --prune=now --aggressive
